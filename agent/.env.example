# 이 파일을 .env 로 복사한 뒤 실제 키를 채운다.
#   cp agent/.env.example agent/.env
# .env 는 gitignore 됨 — 절대 커밋 금지.

# console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에-키

# platform.openai.com 에서 발급 (openai 프로바이더 쓸 때만)
OPENAI_API_KEY=sk-여기에-키

# platform.deepseek.com 에서 발급 (deepseek 프로바이더 쓸 때만)
DEEPSEEK_API_KEY=sk-여기에-키

# 개발 중 프로바이더 전환 (없으면 claude). 값: claude / openai / deepseek
# LLM_PROVIDER=claude
